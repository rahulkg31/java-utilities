<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.example.taskmanager</groupId>
    <artifactId>java-application-template</artifactId>
    <version>1.0.1</version>

    <properties>
        <java.version>17</java.version>
        <skip.dist>false</skip.dist>
        <dist.staging>${project.build.directory}/${project.build.finalName}</dist.staging>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.20.0</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>java-application-template-${project.version}</finalName>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.example.taskmanager.TaskManagerApplication</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathLayoutType>simple</classpathLayoutType>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependency-jars</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.example.taskmanager.TaskManagerApplication</mainClass>
                    <classifier>executable</classifier>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>build-distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.dist}</skip>
                            <target>

                                <delete dir="${dist.staging}"/>
                                <mkdir dir="${dist.staging}"/>

                                <mkdir dir="${dist.staging}/bin"/>
                                <copy todir="${dist.staging}/bin">
                                    <fileset dir="${project.basedir}/bin">
                                        <include name="*.sh"/>
                                        <include name="*.bat"/>
                                        <include name="*.service"/>
                                    </fileset>
                                </copy>
                                <chmod perm="0755">
                                    <fileset dir="${dist.staging}/bin">
                                        <include name="*.sh"/>
                                        <include name="*.bat"/>
                                    </fileset>
                                </chmod>

                                <mkdir dir="${dist.staging}/config"/>
                                <copy todir="${dist.staging}/config">
                                    <fileset dir="${project.basedir}/src/main/resources">
                                        <include name="application.yml"/>
                                        <include name="application-default.yml"/>
                                        <include name="log4j2.xml"/>
                                    </fileset>
                                </copy>
                                <mkdir dir="${dist.staging}/config/certs"/>
                                <copy todir="${dist.staging}/config/certs" failonerror="false">
                                    <fileset dir="${project.basedir}/config/certs"/>
                                </copy>

                                <mkdir dir="${dist.staging}/db/migration"/>
                                <copy todir="${dist.staging}/db/migration">
                                    <fileset dir="${project.basedir}/src/main/resources/db/migration"/>
                                </copy>

                                <mkdir dir="${dist.staging}/docker"/>
                                <copy todir="${dist.staging}/docker">
                                    <fileset dir="${project.basedir}/docker">
                                        <include name="*.sh"/>
                                    </fileset>
                                </copy>
                                <chmod perm="0755">
                                    <fileset dir="${dist.staging}/docker">
                                        <include name="*.sh"/>
                                    </fileset>
                                </chmod>
                                <copy todir="${dist.staging}/docker">
                                    <fileset dir="${project.basedir}/docker">
                                        <exclude name="*.sh"/>
                                        <exclude name="**/*-dev.*"/>
                                        <exclude name="**/*.dev"/>
                                    </fileset>
                                </copy>

                                <mkdir dir="${dist.staging}/docs"/>
                                <copy todir="${dist.staging}/docs">
                                    <fileset dir="${project.basedir}/docs"/>
                                </copy>

                                <mkdir dir="${dist.staging}/scripts"/>
                                <copy todir="${dist.staging}/scripts">
                                    <fileset dir="${project.basedir}/scripts">
                                        <include name="*.sh"/>
                                    </fileset>
                                </copy>
                                <chmod perm="0755">
                                    <fileset dir="${dist.staging}/scripts">
                                        <include name="*.sh"/>
                                    </fileset>
                                </chmod>

                                <mkdir dir="${dist.staging}/logs"/>
                                <mkdir dir="${dist.staging}/data"/>

                                <copy file="${project.basedir}/README.md" todir="${dist.staging}"/>

                                <echo file="${dist.staging}/VERSION" message="${project.version}${line.separator}"/>

                                <mkdir dir="${dist.staging}/lib"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${dist.staging}/lib/${project.build.finalName}.jar"/>
                                <copy todir="${dist.staging}/lib">
                                    <fileset dir="${project.build.directory}/dependency-jars"/>
                                </copy>

                                <tar destfile="${project.build.directory}/${project.build.finalName}.tar.gz"
                                     compression="gzip" longfile="gnu">
                                    <tarfileset dir="${project.build.directory}" filemode="755">
                                        <include name="${project.build.finalName}/bin/*.sh"/>
                                        <include name="${project.build.finalName}/bin/*.bat"/>
                                        <include name="${project.build.finalName}/docker/*.sh"/>
                                        <include name="${project.build.finalName}/scripts/*.sh"/>
                                    </tarfileset>
                                    <tarfileset dir="${project.build.directory}">
                                        <include name="${project.build.finalName}/**"/>
                                        <exclude name="${project.build.finalName}/bin/*.sh"/>
                                        <exclude name="${project.build.finalName}/bin/*.bat"/>
                                        <exclude name="${project.build.finalName}/docker/*.sh"/>
                                        <exclude name="${project.build.finalName}/scripts/*.sh"/>
                                    </tarfileset>
                                </tar>

                                <zip destfile="${project.build.directory}/${project.build.finalName}.zip">
                                    <zipfileset dir="${project.build.directory}" filemode="755">
                                        <include name="${project.build.finalName}/bin/*.sh"/>
                                        <include name="${project.build.finalName}/bin/*.bat"/>
                                        <include name="${project.build.finalName}/docker/*.sh"/>
                                        <include name="${project.build.finalName}/scripts/*.sh"/>
                                    </zipfileset>
                                    <zipfileset dir="${project.build.directory}">
                                        <include name="${project.build.finalName}/**"/>
                                        <exclude name="${project.build.finalName}/bin/*.sh"/>
                                        <exclude name="${project.build.finalName}/bin/*.bat"/>
                                        <exclude name="${project.build.finalName}/docker/*.sh"/>
                                        <exclude name="${project.build.finalName}/scripts/*.sh"/>
                                    </zipfileset>
                                </zip>

                            </target>
                        </configuration>
                    </execution>

                    <execution>
                        <id>checksum-distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.dist}</skip>
                            <target>
                                <checksum file="${project.build.directory}/${project.build.finalName}.tar.gz"
                                          algorithm="SHA-256" fileext=".sha256"/>
                                <checksum file="${project.build.directory}/${project.build.finalName}.zip"
                                          algorithm="SHA-256" fileext=".sha256"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>