[Unit]
Description=Java Application Template
After=network.target

[Service]
Type=simple
User=appuser
Group=appuser

WorkingDirectory=/opt/java-application-template

ExecStart=/bin/bash -c 'exec /usr/bin/java \
    -Dlog4j.configurationFile=/opt/java-application-template/config/log4j2.xml \
    -jar /opt/java-application-template/lib/java-application-template*.jar \
    --spring.config.additional-location=file:/opt/java-application-template/config/'

SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

